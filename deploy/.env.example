# MySQL 连接（连接物理机已有的 MySQL）
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=huasen
MYSQL_PASSWORD=your_password

# Redis 密码（首次部署时自己设定一个强密码，容器会用这个作为认证密码）
# 生成强密码：openssl rand -base64 24
REDIS_PASSWORD=your_password

# Elasticsearch 开关（不需要全文搜索时设为 false）
ES_ENABLED=true

# 七牛云对象存储
QINIU_ACCESS_KEY=your_key
QINIU_SECRET_KEY=your_key
QINIU_BUCKET=your_bucket
QINIU_DOMAIN=https://your_domain

# 阿里云百炼 AI（用于生成文章摘要、网站描述）
BAILIAN_API_KEY=sk-xxx
BAILIAN_MODEL=qwen3.7-max
